# 1989 configuration
# This is the main configuration file. On first run 1989 creates
# ~/.config/1989/1989.conf with these defaults; edit it there (or copy this
# example) or use the F9 overlay / F1 options dialog.
# All paths may be absolute or relative to the current working directory.

[System]
# 0 = NeXT Computer (68030 Cube), 1 = NeXTcube, 2 = NeXTcube Turbo,
# 3 = NeXTstation, 4 = NeXTstation Turbo, 5 = NeXTstation Color,
# 6 = NeXTstation Turbo Color, 7 = NeXTdimension Graphics Board
nMachineType = 0
bColor = 0
bTurbo = 0
bNBIC = 1
bADB = 0
nSCSI = 0
nRTC = 0
nCpuLevel = 3
nCpuFreq = 25
bCompatibleCpu = 0
bRealtime = 0
nDSPType = 0
bDSPMemoryExpansion = 0
n_FPUType = 0
bCompatibleFPU = 1
bMMU = 1

[Memory]
nMemoryBankSize0 = 4
nMemoryBankSize1 = 4
nMemoryBankSize2 = 4
nMemoryBankSize3 = 4
nMemorySpeed = 0

[Boot]
nBootDevice = 0
bEnableDRAMTest = 1
bEnablePot = 0
bEnableSoundTest = 0
bEnableSCSITest = 0
bLoopPot = 0
bVerbose = 0
bExtendedPot = 0
bVisible = 0

[ROM]
# Machine ROMs. Defaults point at the data dir (and the install-time
# ROM_INSTALL_DIR); set absolute paths to use images elsewhere.
szRom030FileName = Rev_1.0_v41.BIN
szRom040FileName = Rev_2.5_v66.BIN
szRomTurboFileName = Rev_3.3_v74.BIN
bUseCustomMac = 0
nRomCustomMac0 = 0
nRomCustomMac1 = 0
nRomCustomMac2 = 15
nRomCustomMac3 = 0
nRomCustomMac4 = 0
nRomCustomMac5 = 0

[HardDisk]
# SCSI target images (sd, raw, ISO/ECC optical disk images)
szImageName0 =
nDeviceType0 = 0
bDiskInserted0 = 0
bWriteProtected0 = 0
# ... targets 1..6 follow the same pattern

[Floppy]
# 400k, 720k, 1440k (and 2.88M) floppy images
szImageName0 =
bDriveConnected0 = 0
bDiskInserted0 = 0
bWriteProtected0 = 0
# ... drives 1..3 follow the same pattern

[MagnetoOptical]
# Magneto-optical disk image (sd)
szImageName =
bDiskInserted = 0
bWriteProtected = 0

[Ethernet]
# Networking: 0 = disabled, 1 = SLiRP user-mode NAT, 2 = pcap (if built with pcap)
nEthernetType = 0
nPort = 0

[Sound]
bEnableSound = 1
bEnableMicrophone = 1

[Screen]
nMode = 0
nGroupModePos0 = 0
nGroupModePos1 = -1
nGroupModePos2 = -1
nGroupModePos3 = -1
nSingleModeSlot = 0
bFullScreen = 0
bShowStatusbar = 1
bShowTitlebar = 1

[ShortcutsWithoutModifiers]
kOptions = F1
kFullScreen = F11
kQuit = F12
kColdReset = F5

[ShortcutsWithModifiers]
# Modifier + key. Default modifier is Alt.
kOptions = O
kFullScreen = F
kMouseMode = M
kColdReset = C
kScreenshot = G
kRecord = R
kSound = S
kPause = P
kDebuggerM68K = D
kDebuggerI860 = I
kQuit = Q
kDimension = N
kStatusbar = B
kTitlebar = T

[Log]
bEnableLog = 0
bEnableTrace = 0

[UI89]
# Happy-years UI settings (F9 overlay).
bTinker = FALSE
bSmoothing = TRUE
nGifWidth = 480
nGifFps = 25
nNotifyMode = 1
