# 1989 configuration
# Example keys for ~/.config/1989/1989.conf (created on first run).
# This is a partial example; the generated file includes all defaults.
# Edit while the emulator is closed, or use F9 / the F1 legacy dialog.
# All paths may be absolute or relative to the current working directory.

[System]
# 0 = NeXT Computer (68030), 1 = NeXTcube (68040), 2 = NeXTstation.
# Turbo and Color are separate flags; NeXTdimension is configured separately.
nMachineType = 0
bColor = 0
bTurbo = 0
bNBIC = 1
bADB = 0
nSCSI = 0
nRTC = 0
nCpuLevel = 3
nCpuFreq = 25
bCompatibleCpu = 0
bRealtime = 0
nDSPType = 2
bDSPMemoryExpansion = 0
n_FPUType = 68882
bCompatibleFPU = 1
# Retained for config compatibility; the NeXT core always enables the MMU.
bMMU = 1

[Memory]
nMemoryBankSize0 = 16
nMemoryBankSize1 = 16
nMemoryBankSize2 = 16
nMemoryBankSize3 = 16
nMemorySpeed = 1

[Boot]
nBootDevice = 0
bEnableDRAMTest = 0
bEnablePot = 1
bEnableSoundTest = 1
bEnableSCSITest = 1
bLoopPot = 0
bVerbose = 1
bExtendedPot = 0
bVisible = 0

[ROM]
# Machine ROMs. Defaults point at the data dir (and the install-time
# ROM_INSTALL_DIR); set absolute paths to use images elsewhere.
szRom030FileName = Rev_1.0_v41.BIN
szRom040FileName = Rev_2.5_v66.BIN
szRomTurboFileName = Rev_3.3_v74.BIN
bUseCustomMac = 0
nRomCustomMac0 = 0
nRomCustomMac1 = 0
nRomCustomMac2 = 15
nRomCustomMac3 = 0
nRomCustomMac4 = 0
nRomCustomMac5 = 0

[HardDisk]
# SCSI target IDs: 1 system HDD, 2 data, 3 CD-ROM, 4 SCSI floppy,
# 0 alternate boot, 5 spare, 6 extra/swap. ID 7 is the host controller.
# Type: 0 disconnected, 1 HDD, 2 CD-ROM, 3 SCSI floppy.
# Example system slot, left disconnected until an image is selected:
szImageName1 =
nDeviceType1 = 0
bDiskInserted1 = 0
bWriteProtected1 = 0
# Other target IDs use the same keys with their ID suffix, never an sdN number.
# MO/ECC images belong in [MO], not in a SCSI CD-ROM slot.

[Floppy]
# 720 KiB, 1.44 MiB or 2.88 MiB raw floppy images
szImageName0 =
bDriveConnected0 = 0
bDiskInserted0 = 0
bWriteProtected0 = 0
# ... drives 1..3 follow the same pattern

[MagnetoOptical]
# Previous-compatible MO image; repeat with suffix 1 for the second drive.
szImageName0 =
bDriveConnected0 = 0
bDiskInserted0 = 0
bWriteProtected0 = 0

[Ethernet]
bEthernetConnected = 0
bTwistedPair = 0
# 0 = SLiRP, 1 = pcap (requires build support).
nHostInterface = 0
szInterfaceName =
bNetworkTime = 0
# NFS directory/name keys are szNFSPathName0..3 and szNFSHostName0..3.
# Keep the generated first share path or select a valid directory in F1.

[Sound]
bEnableSound = 1
bEnableMicrophone = 1

[Screen]
nMode = 0
nGroupModePos0 = 0
nGroupModePos1 = -1
nGroupModePos2 = -1
nGroupModePos3 = -1
nSingleModeSlot = 0
bFullScreen = 0
bShowStatusbar = 0
bShowTitlebar = 1

[ShortcutsWithoutModifiers]
kOptions = F1
kFullScreen = F11
kQuit = F12
kColdReset = F5

[ShortcutsWithModifiers]
# Modifier + key. The modifier is Ctrl+Alt.
kOptions = O
kFullScreen = F
kMouseMode = M
kColdReset = C
kScreenshot = G
kRecord = R
kSound = S
kPause = P
kDebuggerM68K = D
kDebuggerI860 = I
kQuit = Q
kDimension = N
kStatusbar = B
kTitlebar = T

[Log]
sLogFileName = stderr
sTraceFileName = stderr
bConfirmQuit = 1

[UI89]
# Happy-years UI settings (F9 overlay).
bTinker = FALSE
bSmoothing = TRUE
# Real CRT scanline effect and its visibility (0..95 %).
bCrtEnabled = FALSE
nCrtScanlines = 35
# Show emulator debug/log output on the terminal (Advanced > Debugging).
bDebug = FALSE
# RTC reports the host's local wall-clock time (TRUE) or UTC (FALSE).
bRtcLocalTime = TRUE
# Optimize recorded GIFs through ffmpeg when available.
bGifFfmpeg = FALSE
# Window scale as a percentage of the native size (0 = fit to display).
nWindowScale = 0
nGifWidth = 480
nGifFps = 25
nNotifyMode = 1
# Last directory browsed for each media entry (szLastDir1..szLastDir14),
# maintained automatically by the F9 overlay.
szLastDir1 =
szLastDir2 =
szLastDir3 =
szLastDir4 =
szLastDir5 =
szLastDir6 =
szLastDir7 =
szLastDir8 =
szLastDir9 =
szLastDir10 =
szLastDir11 =
szLastDir12 =
szLastDir13 =
szLastDir14 =
